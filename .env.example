# StockInsight 환경 설정

# 1. Runtime
NODE_ENV=development

# 2. Supabase
# URL과 publishable key는 브라우저에 노출되는 공개 값입니다.
# secret key는 서버/관리자 전용입니다. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=.....
SUPABASE_SECRET_KEY=.....

# 3. Admin
# 여러 명이면 쉼표로 구분합니다.
ADMIN_EMAILS=admin@example.com

# 4. Trends runtime
# Vercel /api/pytrends 내부 서버 호출 보호용 secret입니다.
PYTRENDS_INTERNAL_SECRET=.....

# 5. Redis cache (선택)
# 미설정 시 외부 API를 직접 조회합니다.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
STOCK_DATA_CACHE_TTL_SECONDS=86400
TRENDS_CACHE_TTL_SECONDS=86400

# 6. Playwright E2E test accounts
# 로컬 실행 시 .env.local에 설정합니다.
# GitHub Actions에서는 Repository Secrets로 주입합니다.
# Vercel 환경변수에는 넣지 않습니다.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
