# StockInsight 환경 설정 (Phase 6: Supabase 단일 기반)

# 실행 환경 (development, production, test)
NODE_ENV=development

# Supabase 프로젝트 URL (필수)
# https://supabase.com에서 프로젝트 생성 후 프로젝트 설정에서 확인할 수 있습니다
# 형식: https://YOUR_PROJECT_ID.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# 클라이언트에서 접근하는 Supabase URL (필수)
# 서버/클라이언트 모두에서 사용되며, NEXT_PUBLIC_ 접두사로 클라이언트에 노출됨
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase publishable key (필수)
# Supabase Dashboard → Settings → API Keys → Publishable keys에서 복사합니다.
# 브라우저에 노출되어도 되는 공개 키이며, 실제 데이터 접근은 RLS 정책으로 보호됩니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=.....

# Supabase secret key (관리자/서버 전체 조회용, 권장)
# Supabase Dashboard → Settings → API Keys → Secret keys에서 생성/복사합니다.
# 서버 전용입니다. 절대 NEXT_PUBLIC_ 접두사를 붙이거나 클라이언트에 노출하지 마세요.
SUPABASE_SECRET_KEY=.....

# Deprecated legacy fallback keys (기존 환경 호환용, 새 키 전환 후 제거 예정)
# 새 Publishable/Secret key 설정 후에는 사용하지 않습니다.
# SUPABASE_KEY=제거예정
# NEXT_PUBLIC_SUPABASE_ANON_KEY=제거예정
# SUPABASE_SERVICE_ROLE_KEY=제거예정

# Redis 캐시 (선택)
# 주가 5년 주간 데이터와 pytrends 조회 결과 캐시용.
# 미설정 시 기존처럼 외부 API를 직접 조회합니다.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
STOCK_DATA_CACHE_TTL_SECONDS=86400
TRENDS_CACHE_TTL_SECONDS=86400
PREVIEW_CACHE_TTL_SECONDS=86400

# Internal server-to-server auth for /api/pytrends on Vercel
# Generate a long random value and set the same value in Vercel environment variables.
PYTRENDS_INTERNAL_SECRET=.....

# 관리자 페이지 접근 허용 이메일 목록 (쉼표로 구분)
ADMIN_EMAILS=admin@example.com
