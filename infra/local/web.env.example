WEB_AUTH_MODE=oidc
WEB_ORIGIN=http://localhost:3000
OIDC_ISSUER=http://localhost:8180/realms/stock-insight
OIDC_CLIENT_ID=stock-insight-web
OIDC_ALLOW_LOCAL_HTTP=true
ANALYSIS_GATEWAY_URL=http://localhost:8080
WEB_SESSION_REDIS_URL=redis://127.0.0.1:6379
# Generate with openssl rand -hex 32; do not commit the generated secret.
WEB_SESSION_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
